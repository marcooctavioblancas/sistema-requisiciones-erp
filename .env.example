# Copia este archivo a ".env" y llena los valores.
# ".env" nunca se sube a git. Docker Compose lo carga en el contenedor "app"
# y PHP lo lee con getenv() (ver includes/config.php e includes/mail_config.php).

# IA para analizar cotizaciones (opcional) -- Groq Cloud, console.groq.com > API Keys
GROQ_API_KEY=

# Correo saliente para solicitar cotizaciones a proveedores (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
